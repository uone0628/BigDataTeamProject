import pandas as pd

df = pd.read_csv('data/Student_data.csv')

cutoff = df['Final_CGPA'].quantile(0.85)

top_students = df[df['Final_CGPA'] >= cutoff]

analysis_items = [
    'Final_CGPA', 
    'Study_Hours_Per_Day', 
    'Sleep_Hours', 
    'Attendance_Pct', 
    'Social_Hours_Week'
]

result = top_students.groupby('Major')[analysis_items].mean().round(2)

print("전공분야별 상위 15% 학생들의 특징")
print(result)